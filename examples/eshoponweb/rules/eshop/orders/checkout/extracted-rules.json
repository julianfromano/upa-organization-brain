{
  "assumptions": [],
  "business_rules": [
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_CHECKOUT_REQUIRES_AUTHENTICATED_USER",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "[Authorize]"
      },
      "text": "an unauthenticated request creates no order and does not delete the basket"
    },
    {
      "classification": "DERIVED_RULE",
      "id": "BR_CHECKOUT_USES_FIXED_ADDRESS",
      "kind": "ensures",
      "origin": {
        "kind": "derived",
        "ref": "DD_FIXED_SHIPPING_ADDRESS"
      },
      "text": "every order created by checkout uses the address hard-coded in the page"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_CHECKOUT_DELETES_BASKET_AFTER_ORDER",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "await _basketService.DeleteBasketAsync(BasketModel.Id);"
      },
      "text": "after order creation, the basket and its lines are removed"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_FAILED_ORDER_PRESERVES_BASKET",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "catch (EmptyBasketOnCheckoutException emptyBasketOnCheckoutException)"
      },
      "text": "when checkout creates no order, an existing basket remains available"
    },
    {
      "classification": "DERIVED_RULE",
      "id": "BR_ORDER_LINE_USES_RECORDED_BASKET_PRICE",
      "kind": "ensures",
      "origin": {
        "kind": "derived",
        "ref": "DD_FIXED_SHIPPING_ADDRESS"
      },
      "text": "the purchased line keeps the price recorded in the basket"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Access_BR_SHOPPER_REQUIRES_AUTHENTICATION",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "[Authorize]"
      },
      "text": "protected shopper operations require an authenticated user"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Buyer_BR_SIGNED_IN_BUYER_USES_USER_NAME",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "return Request.HttpContext.User.Identity.Name!;"
      },
      "text": "an authenticated shopper is identified by their user name and receives no basket cookie"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Buyer_BR_ANONYMOUS_GUID_COOKIE_IS_REUSED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "if (!Guid.TryParse(userName, out var _))"
      },
      "text": "an anonymous shopper with a valid GUID cookie reuses that basket"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Buyer_BR_INVALID_OR_MISSING_COOKIE_CREATES_BUYER",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "userName = Guid.NewGuid().ToString();"
      },
      "text": "an anonymous shopper without a valid GUID cookie receives a new basket identity and cookie"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Buyer_BR_MISSING_IDENTITY_IS_REJECTED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.Null(Request.HttpContext.User.Identity, nameof(Request.HttpContext.User.Identity));"
      },
      "text": "a missing request identity cannot resolve a basket buyer"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Lines_BR_BASKET_QUANTITY_IS_NONNEGATIVE",
      "kind": "invariant",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.OutOfRange(quantity, nameof(quantity), 0, int.MaxValue);"
      },
      "text": "basket line quantities are never negative"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Lines_BR_SUBMITTED_QUANTITY_REPLACES_EXISTING",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "item.SetQuantity(quantity);"
      },
      "text": "a submitted quantity replaces the existing line quantity"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Lines_BR_QUANTITY_UPDATE_PRESERVES_PRICE",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "item.SetQuantity(quantity);"
      },
      "text": "changing a line quantity does not reprice it"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Lines_BR_UNSUBMITTED_LINE_IS_UNCHANGED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "if (quantities.TryGetValue(item.Id.ToString(), out var quantity))"
      },
      "text": "a line omitted from the submitted quantities is not changed"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Lines_BR_ZERO_QUANTITY_LINES_ARE_REMOVED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "_items.RemoveAll(i => i.Quantity == 0);"
      },
      "text": "cleanup removes zero-quantity lines from the selected basket"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Update_Lines_BR_CLEANUP_PRESERVES_OTHER_LINES",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "_items.RemoveAll(i => i.Quantity == 0);"
      },
      "text": "cleanup preserves other baskets' lines and nonempty lines"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Order_BR_ORDER_LINE_SUBTOTAL",
      "kind": "invariant",
      "origin": {
        "kind": "literal",
        "ref": "total += item.UnitPrice * item.Units;"
      },
      "text": "each order-line subtotal equals unit price times units"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Order_BR_ORDER_LINE_SNAPSHOT_IMMUTABLE",
      "kind": "law",
      "origin": {
        "kind": "literal",
        "ref": "/// Represents a snapshot of the item that was ordered."
      },
      "text": "a recorded order line keeps its purchased name, image, price, and units"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Order_BR_ORDER_LINE_USES_BASKET_PRICE",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "var orderItem = new OrderItem(itemOrdered, basketItem.UnitPrice, basketItem.Quantity);"
      },
      "text": "an order line copies price and units from the basket line, not the current catalog price"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Order_BR_ORDER_LINE_SNAPSHOTS_CATALOG_ITEM",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "new CatalogItemOrdered(catalogItem.Id, catalogItem.Name, _uriComposer.ComposePicUri(catalogItem.PictureUri))"
      },
      "text": "an order line records the catalog name, image, and item identifier at purchase time"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Order_BR_DELETED_CATALOG_ITEM_ABORTS_ORDER_LINE",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "var catalogItem = catalogItems.First(c => c.Id == basketItem.CatalogItemId);"
      },
      "text": "a basket line whose catalog item is missing does not produce an order line"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Order_BR_INVALID_ITEM_ID_ABORTS_ORDER_LINE",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.OutOfRange(catalogItemId, nameof(catalogItemId), 1, int.MaxValue);"
      },
      "text": "an item identifier outside the valid integer range does not produce an order line"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Order_BR_ORDER_TOTAL_ACCUMULATES_SUBTOTAL",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "total += item.UnitPrice * item.Units;"
      },
      "text": "the order total increases by the subtotal of each created line"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "Lines_BR_BASKET_QUANTITY_IS_NONNEGATIVE",
      "kind": "invariant",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.OutOfRange(quantity, nameof(quantity), 0, int.MaxValue);"
      },
      "text": "basket line quantities are never negative"
    },
    {
      "classification": "EXTERNAL_ASSUMPTION",
      "id": "Lines_BR_DELETE_BASKET_CASCADES_TO_LINES",
      "kind": "ensures",
      "origin": {
        "kind": "assumption",
        "ref": "AS_DATABASE_CASCADE"
      },
      "text": "deleting a basket removes the basket and its lines"
    }
  ],
  "decisions": [
    {
      "classification": "DESIGN_DECISION",
      "id": "DD_FIXED_SHIPPING_ADDRESS",
      "text": "The checkout address is hard-coded in the page; the shopper does not enter it"
    },
    {
      "classification": "DESIGN_DECISION",
