{
  "assumptions": [],
  "business_rules": [
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_VALID_DETAILS_ARE_APPLIED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Name = details.Name;"
      },
      "text": "valid name, description, and price replace the item's details"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_NONPOSITIVE_PRICE_IS_REJECTED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.NegativeOrZero(details.Price, nameof(details.Price));"
      },
      "text": "a zero or negative price leaves the item unchanged"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_EMPTY_NAME_IS_REJECTED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.NullOrEmpty(details.Name, nameof(details.Name));"
      },
      "text": "an empty name leaves the item unchanged"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_EMPTY_DESCRIPTION_IS_REJECTED",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.NullOrEmpty(details.Description, nameof(details.Description));"
      },
      "text": "an empty description leaves the item unchanged"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_DETAILS_DO_NOT_CHANGE_CLASSIFICATION",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Name = details.Name;"
      },
      "text": "updating details does not change the brand, type, or image"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_BRAND_MUST_BE_NONZERO",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.Zero(catalogBrandId, nameof(catalogBrandId));"
      },
      "text": "a zero brand identifier is rejected"
    },
    {
      "classification": "EXPLICIT_RULE",
      "id": "BR_TYPE_MUST_BE_NONZERO",
      "kind": "ensures",
      "origin": {
        "kind": "literal",
        "ref": "Guard.Against.Zero(catalogTypeId, nameof(catalogTypeId));"
      },
      "text": "a zero type identifier is rejected"
    }
  ],
  "decisions": [
    {
      "classification": "DESIGN_DECISION",
      "id": "DD_PRICE_SCALE",
      "text": "Catalog prices use decimal(18,2), represented as integer cents"
    }
  ],
